from edgar import set_identity, Company
from dotenv import load_dotenv
import os
import pandas as pd

df = pd.read_csv("src/leverage_status.csv")

missing_liabilities = df[df["liabilities_missing"] == True]["ticker"]

load_dotenv()

user_agent = os.getenv("SEC_user_agent")

set_identity(user_agent)

recovered = []
still_missing = []
no_data = []

for ticker in missing_liabilities:
    company = Company(ticker)
    financial_data = company.get_financials()

    if financial_data is None:
        no_data.append(ticker)
        continue

    concept_search = financial_data.xb.query().by_concept("us-gaap:Liabilities", exact = True).to_dataframe()

    #.to_dataframe returns a empty dataframe instead of none type
    if concept_search.empty:
        still_missing.append(ticker)
    else:
        recovered.append(ticker)

print(f"recovered:{len(recovered)}")
print(recovered)
print(f"still missing:{len(still_missing)}")
print(still_missing)
print(f"no data:{len(no_data)}")
print(no_data)

